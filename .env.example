# CogNote environment template.
# Copy to .env.local and fill in. Never commit .env.local.
#
# Local dev:      cp .env.example .env.local
# Docker deploy:  cp docker-compose.example.yml docker-compose.yml
#                 cp .env.example .env.local
#                 sh docker/supabase/generate-secrets.sh   # paste output in
#                 docker compose --env-file .env.local up -d --build

# --- Supabase (required) ----------------------------------------------------
# Build + runtime. NEXT_PUBLIC_* are inlined into the client bundle at build
# time — changing them requires a rebuild (not just a container restart).
#
# When using the bundled Docker stack these two are filled in automatically from
# ANON_KEY / SUPABASE_PUBLIC_URL (see the "Docker self-host stack" section
# below), so you can leave them blank. Set them explicitly only when pointing at
# an external Supabase (hosted, or a separate self-hosted deployment).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Bypasses RLS — never expose to the client.
# Filled in automatically from SERVICE_ROLE_KEY with the bundled Docker stack.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. 32-byte hex used to encrypt portal tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Cron (recommended if self-hosting /api/cron/*) -------------------------
# Bearer token authorising /api/cron/* endpoints (e.g. event reminders).
CRON_SECRET=

# Public site origin: used for auth redirects and for absolute links built
# outside a request (e.g. cron-invoked reminders). Falls back to the request's
# own origin if unset — and a plain-HTTP request carries no scheme to trust, so
# set this whenever the app is not behind a TLS proxy that forwards
# X-Forwarded-Proto.
NEXT_PUBLIC_SITE_URL=

# --- Email (optional) -------------------------------------------------------
# Unset EMAIL_PROVIDER (or set to "none") and the app runs without sending
# mail — a valid configuration. Set EMAIL_PROVIDER=resend or smtp to enable.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# SMTP only (e.g. local Mailpit):
SMTP_HOST=
SMTP_PORT=

# --- Beta gate (optional) ---------------------------------------------------
# NEXT_PUBLIC_BETA_ONLY=true shows the beta-code + waitlist UI (rebuild after
# change). BETA_ACCESS_CODE is the server-only secret checked on signup.
NEXT_PUBLIC_BETA_ONLY=
BETA_ACCESS_CODE=

# --- Deployment mode --------------------------------------------------------
# Leave unset (or "self_hosted") for a normal self-host. Official CogNote
# Hosted Pro sets "hosted" — do not set that on your own deploy.
COGNOTE_DEPLOYMENT=

# --- Docker self-host stack (docker-compose.example.yml) --------------------
# Everything below is only read by the bundled Docker stack. Local dev against
# an external Supabase can leave it blank.

# Public origin of the CogNote app. Used for auth redirects and absolute links.
APP_URL=http://localhost:3000
# Host port the app container publishes.
APP_PORT=3000

# Public origin of the Supabase API gateway, as reached by BOTH the browser and
# the app server. Browsers resolve any *.localhost name to 127.0.0.1; the app
# container reaches it via SUPABASE_HOST_ALIAS below. In production, set this to
# a real domain that resolves from both (e.g. https://api.example.com).
SUPABASE_PUBLIC_URL=http://supabase.localhost:8000
# The hostname in SUPABASE_PUBLIC_URL. Change if you use a different name.
SUPABASE_HOST_ALIAS=supabase.localhost
# Host port the gateway publishes.
API_GW_HTTP_PORT=8000

# Stack secrets. Generate all six at once:
#   sh docker/supabase/generate-secrets.sh
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
# Credentials for Storage's S3 protocol endpoint. The bundled gateway denies that
# endpoint (the app does not use it), but the stack requires these values rather
# than defaulting to the demo pair Supabase publishes.
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Auth service. Auto-confirm new signups so email works with no SMTP; set to
# false to require email confirmation, then configure the AUTH_SMTP_* values.
ENABLE_EMAIL_AUTOCONFIRM=true
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_ADMIN_EMAIL=
AUTH_SMTP_SENDER_NAME=

# Event-reminder schedule (5-field cron). Only used with the optional "cron"
# profile: docker compose --env-file .env.local --profile cron up -d
CRON_SCHEDULE=0 14 * * *
